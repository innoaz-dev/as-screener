/*
    AS 스크리너 - 한국어 에이전트 스킬 악성 지시문 탐지 규칙 v0.4.1 (2026-11-02)
    SkillSpector --yara-rules-dir 로 붙여 사용.
    YARA 정규식은 바이트 단위: 한글 1자 = UTF-8 3바이트. [^\n]{0,30} 는 한글 약 10자.

    v0.4 원칙: '시키는 문장(명령형) + 문장 끝'만 잡는다
    - 명령형 바로 뒤가 띄어쓰기·마침표·쉼표·줄바꿈일 때만 일치
      → "무시해라." 는 탐지, "무시하라"는 문구", "보내라는 요청"(인용·금지 문장)은 처음부터 불일치
      → SkillSpector가 표시하는 위치가 실제 공격 줄을 가리킴 (v0.3은 앞쪽 방어 문장을 가리켰음)
    - 제목("이전 지시 무시")·설명문("무시하게 만드는 문장")·단독 '탈옥' 단어는 미탐지
    이력: v0.2 공개 한국어 스킬 246개 오탐 시험 반영 / v0.3 명령형만 탐지 / v0.4 문장 끝 조건, 환경변수 파일 표기 추가
    / v0.4.1 외부 유출: 비밀 정보가 보내는 대상(을/를)일 때만 ("앱 비밀번호로 메일을 보내고" 오탐 수정)
    알려진 한계: 문장 끝 없이 이어 쓰거나 인용형으로 위장한 공격은 놓칠 수 있음 → LLM 2차 검사로 보완
*/

rule ko_instruction_override
{
    meta:
        description = "[KO] 이전 지시·시스템 지침을 무시하라는 지시문"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $prior = /(이전|앞|위|기존|원래|모든|지금까지)[^\n]{0,30}(지시|지침|명령|규칙|프롬프트)[^\n]{0,15}(무시(해라|해|하라|하고|하세요|하십시오|할\s?것)|잊어(라|버려|버리고|버리세요|요)?|따르지\s?(마라|마세요|마|말고|말\s?것))[\s.,!?;:)\]]/
        $system = /(시스템\s?프롬프트|개발자\s?지시|안전\s?(지침|정책|규칙))[^\n]{0,20}(무시|우회|덮어써)(해라|해|하라|하고|하세요|할\s?것)[\s.,!?;:)\]]/
    condition:
        any of them
}

rule ko_concealment_from_user
{
    meta:
        description = "[KO] 사용자에게 숨기라는 은폐 지시문"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $hide = /(사용자|유저|고객)(에게|한테)(는)?[^\n]{0,30}(말하지|알리지|보여\s?주지|언급하지|공개하지|알려\s?주지)\s?(마라|마세요|마십시오|마|말고|말\s?것)[\s.,!?;:)\]]/
    condition:
        $hide
}

rule ko_stealth_wording
{
    meta:
        description = "[KO] 몰래·은밀히 등 은밀 실행 지시"
        category = "exploit"
        severity = "MEDIUM"
        confidence = "0.6"
    strings:
        $s = /(몰래|은밀히|비밀리에|들키지\s?않게|눈치채지\s?못하게)[^\n]{0,30}((전송|실행|설치|수집|복사|업로드|삭제|변경|다운로드|저장)(해라|해|하라|하고|해서|하세요|할\s?것)|보내(라|고|서|세요)|읽(어라|어|고|어서|으세요))[\s.,!?;:)\]]/
    condition:
        $s
}

rule ko_anti_refusal
{
    meta:
        description = "[KO] 제한 해제·거절 금지 등 탈옥 문구"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.85"
    strings:
        $no_limit = /(너|당신|넌|에이전트)(에게는|에게|는|은)?\s?[^\n]{0,9}(어떤|아무런|어느)\s?(제한|제약|규칙)(도|이)?\s?(없(다|어|으며|으니|고|습니다)|적용되지\s?않(는다|아|습니다))[\s.,!?;:)\]]/
        $no_refuse = /(절대|결코|어떤\s?경우에도)\s?(거절|거부)(하지\s?(마라|마세요|마)|해서는\s?안\s?(된다|돼|됩니다)|하면\s?안\s?(된다|돼|됩니다))[\s.,!?;:)\]]/
        $bypass = /(안전|보안|윤리)\s?(규칙|정책|지침|필터)[^\n]{0,15}(무시|우회|해제)(해라|해|하라|하고|하세요)[\s.,!?;:)\]]/
    condition:
        any of them
}

rule ko_credential_access
{
    meta:
        description = "[KO] SSH 키·환경변수 파일·지갑 등 비밀 정보 읽기 지시"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $read = /(SSH\s?(개인|비밀)?\s?키|개인\s?키\s?파일|환경\s?변수\s?파일|\.env\s?파일|시드\s?문구|니모닉|지갑\s?(파일|키))[^\n]{0,60}(읽(어라|어|고|어서|으세요|을\s?것)|열어(라|서|보고)?|복사(해라|해|하고|해서|하라|하세요)|수집(해라|해|하고|해서|하라|하세요)|가져(와라|와|오고|와서|오라)|빼내(라|고|서)?|추출(해라|해|하고|해서|하라))[\s.,!?;:)\]]/
    condition:
        $read
}

rule ko_credential_exfiltration
{
    meta:
        description = "[KO] 비밀 정보를 외부로 전송하라는 유출 지시"
        category = "malware"
        severity = "CRITICAL"
        confidence = "0.85"
    strings:
        $exfil = /(SSH|개인\s?키|비밀\s?키|환경\s?변수|\.env|비밀번호|패스워드|API\s?키|토큰|인증\s?정보|자격\s?증명|쿠키|시드\s?문구|니모닉|지갑)(\s?(파일|값|내용|정보|목록|키))?\s?(을|를|과|와|도|,)[\s\S]{0,120}(전송(해라|해|하라|하고|해서|하세요|할\s?것)|보내(라|고|서|세요|줘)|업로드(해라|해|하라|하고|하세요)|넘겨(라|줘|서))[\s.,!?;:)\]]/
    condition:
        $exfil
}
