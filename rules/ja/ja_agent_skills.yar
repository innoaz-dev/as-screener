/*
    AS 스크리너 - 일본어 에이전트 스킬 악성 지시문 탐지 규칙 v0.1 (2026-11-03)
    SkillSpector --yara-rules-dir rules 로 붙여 사용 (rules 아래 하위 폴더까지 읽음).
    YARA 정규식은 바이트 단위: 가나·한자 1자 = UTF-8 3바이트. [^\n]{0,60} 는 약 20자.
    가나·한자 뒤에 ? 를 바로 붙이지 않는다 (마지막 1바이트에만 걸림) → '(て)?' 처럼 괄호로 묶는다.
    대괄호 [ ] 안에 가나·한자·전각 부호를 넣지 않는다. 정규식 안의 / 는 \/ 로 쓴다.

    원칙: 한국어 v0.4와 같다 — '명령형(〜せよ·〜しろ·〜してください·〜するな) + 문장 끝'만 잡는다
    - 명령형 바로 뒤가 。！、, 띄어쓰기·줄바꿈일 때만 일치
      → "すべて無視せよ。" 는 탐지
      → "「以前の指示を無視してください」という文"(인용: 뒤가 」), "無視しないでください"(부정),
        "無視させようとする"(설명문) 은 처음부터 불일치
    - 은폐 규칙만은 금지형(〜するな·〜しないで)이 곧 공격이므로 금지형을 잡는다
    알려진 한계: 보통형으로 쓴 지시("送信する。"), 돌려 말하기 → LLM 2차 검사로 보완
*/

rule ja_instruction_override
{
    meta:
        description = "[JA] 이전 지시·시스템 지침을 무시하라는 지시문 (일본어)"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $s = /(これまで|今まで|以前|前|上記|先|元|既存|すべて|全て|全部|システム|開発者)(の)?[^\n]{0,30}(指示|指令|命令|ルール|規則|プロンプト|制約|ガイドライン)[^\n]{0,24}(無視(せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)|忘れ(ろ|よ|て|てください|なさい|ること)|破棄(せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)|(に)?従(うな|わないで|わないでください|わないこと))(。|！|!|、|，|,|\.|．|\r|\n|\x20|　)/
    condition:
        $s
}

rule ja_concealment_from_user
{
    meta:
        description = "[JA] 사용자에게 숨기라는 은폐 지시문 (일본어)"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $s = /(ユーザー|ユーザ|利用者|使用者|お客様|顧客)(に|へ|には|へは|に対して)[^\n]{0,40}(伝え|知らせ|教え)(るな|ないで|ないでください|ないこと|てはならない|てはいけない)(。|！|!|？|\?|、|，|,|\.|．|\r|\n|\x20|　|\)|）)/
        $t = /(ユーザー|ユーザ|利用者|使用者|お客様|顧客)(に|へ|には|へは|に対して)[^\n]{0,40}(言(うな|わないで|わないでください|わないこと|ってはならない|ってはいけない)|報告(するな|しないで|しないでください|しないこと|してはならない)|明か(すな|さないで|さないでください|さないこと))(。|！|!|？|\?|、|，|,|\.|．|\r|\n|\x20|　|\)|）)/
        $h = /(ユーザー|ユーザ|利用者)(に|から)(は)?[^\n]{0,30}(隠せ|隠して|隠してください|隠しなさい|隠すこと|秘密に(せよ|しろ|して|してください|しなさい|すること))(。|！|!|？|\?|、|，|,|\.|．|\r|\n|\x20|　|\)|）)/
        $x = /(隠し|秘密の|裏の)(手順|処理|操作|指示|ステップ)(に|について)(は)?[^\n]{0,15}(触れ|言及し|説明し|伝え)(るな|ないで|ないでください|ないこと|てはならない)(。|！|!|？|\?|、|，|,|\.|．|\r|\n|\x20|　|\)|）)/
    condition:
        any of them
}

rule ja_stealth_wording
{
    meta:
        description = "[JA] 몰래·은밀히 등 은밀 실행 지시 (일본어)"
        category = "exploit"
        severity = "MEDIUM"
        confidence = "0.6"
    strings:
        $s = /(こっそり|密かに|ひそかに|秘密裏に|気づかれ(ないように|ないよう|ずに)|ばれ(ないように|ないよう|ずに)|知られ(ないように|ないよう|ずに))[^\n]{0,30}(送信|実行|インストール|収集|コピー|アップロード|削除|変更|ダウンロード|転送|圧縮|保存|共有)(せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)(。|！|!|？|\?|、|，|,|\.|．|\r|\n|\x20|　|\)|）)/
        $k = /(こっそり|密かに|ひそかに|秘密裏に|気づかれ(ないように|ないよう|ずに)|ばれ(ないように|ないよう|ずに)|知られ(ないように|ないよう|ずに))[^\n]{0,30}(送(れ|って|ってください|りなさい|ること)|読み取(れ|って|ってください|りなさい|ること))[^\n]{0,3}(。|！|、|\r|\n)/
    condition:
        any of them
}

rule ja_anti_refusal
{
    meta:
        description = "[JA] 제한 해제·거절 금지 등 탈옥 문구 (일본어)"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.85"
    strings:
        $no_limit = /(お前|あなた|君|きみ|貴方|貴様)(に|には|は|には今|は今)?[^\n]{0,12}(一切の|いかなる|何の|なんの|どんな)[^\n]{0,12}(制限|制約|ルール|規則|ポリシー|方針|フィルター)(も)?(が|は)?(ない|なく|ありません|存在しない|適用されない)(。|！|!|？|\?|、|，|,|\.|．|\r|\n|\x20|　|\)|）)/
        $persona = /(お前|あなた|君|貴方)は(今から|これから|もう)?[^\n]{0,9}(制限|制約|検閲|フィルター|ルール)(の|が)(ない|無い)[^\n]{0,15}(AI|ＡＩ|アシスタント|モデル|存在|人工知能)/
        $no_refuse = /(絶対に|決して|どんな場合でも|いかなる場合も|何があっても)(拒否|拒絶)(してはならない|してはいけない|するな|しないで|しないでください|しないこと)(。|！|!|？|\?|、|，|,|\.|．|\r|\n|\x20|　|\)|）)/
        $bypass = /(安全|セキュリティ|倫理|コンテンツ)(の)?(ルール|規則|ポリシー|方針|ガイドライン|フィルター|制限)[^\n]{0,15}(無視|回避|解除|迂回)((せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)(。|！|!|？|\?|、|，|,|\.|．|\r|\n|\x20|　|\)|）)|して(答え|回答し|応答し|実行し|出力し|続け)(ろ|よ|て|てください|なさい|ること))/
    condition:
        any of them
}

rule ja_credential_access
{
    meta:
        description = "[JA] SSH 키·지갑·브라우저 비밀번호 등 비밀 정보 읽기 지시 (일본어)"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $s = /(\bSSH ?(の)?(秘密)?鍵|秘密鍵ファイル|\bid_rsa|\.ssh|シードフレーズ|ニーモニック|ウォレット(の)?(秘密鍵|ファイル)|ブラウザ(に保存された|の保存済み|の)?パスワード|\.aws\/credentials)[^\n]{0,60}(読み取(れ|って|ってください|りなさい|ること|り)|読み込(め|んで|んでください|みなさい|むこと|み)|コピー(せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)|コピーし|収集(せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)|収集し|取得(せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)|取得し|抽出(せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)|抽出し|盗(め|んで|み出せ|み出して)|開(け|いて|いてください|きなさい|くこと))((。|！|!|、|，|,|\r|\n|\x20|　)|(から|次に|それを|その|中身|内容|表|一覧|まとめ|保存|送|アップロード|転送))/
    condition:
        $s
}

rule ja_credential_exfiltration
{
    meta:
        description = "[JA] 비밀 정보를 외부로 전송하라는 유출 지시 (일본어)"
        category = "malware"
        severity = "CRITICAL"
        confidence = "0.85"
    strings:
        $s = /(\bSSH|秘密鍵|\.ssh|環境変数|\.env\b|パスワード|\b[Tt]oken\b|トークン|APIキー|\bAPI ?[Kk]ey|認証情報|資格情報|クッキー|\b[Cc]ookie|シードフレーズ|ニーモニック|ウォレット)(\x20)?(ファイル|フォルダ|ディレクトリ|の内容|の値|情報)?(\x20)?(を|と|や|、|も)([\x00-\x09\x0b-\x7f]|[\xc2-\xdf][\x80-\xbf]|[\xe0-\xe2\xe4-\xef][\x80-\xbf][\x80-\xbf]|\xe3[\x81-\xbf][\x80-\xbf]|\xe3\x80[\x80\x81\x83-\xbf]|[\xf0-\xf4][\x80-\xbf][\x80-\xbf][\x80-\xbf]){0,40}((、|，|,)\r?\n([\x00-\x09\x0b-\x7f]|[\xc2-\xdf][\x80-\xbf]|[\xe0-\xe2\xe4-\xef][\x80-\xbf][\x80-\xbf]|\xe3[\x81-\xbf][\x80-\xbf]|\xe3\x80[\x80\x81\x83-\xbf]|[\xf0-\xf4][\x80-\xbf][\x80-\xbf][\x80-\xbf]){0,40})?((送信|アップロード|転送)(せよ|しろ|して|してください|して下さい|しなさい|すること|するように|してくれ)|送(れ|って|ってください|りなさい|ること))(。|！|!|、|，|,|\r|\n|\x20|　)/
    condition:
        $s
}
