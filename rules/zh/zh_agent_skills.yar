/*
    AS 스크리너 - 중국어 에이전트 스킬 악성 지시문 탐지 규칙 v0.1 (2026-11-02)
    SkillSpector --yara-rules-dir rules 로 붙여 사용 (rules 아래 하위 폴더까지 읽음).
    YARA 정규식은 바이트 단위: 한자 1자 = UTF-8 3바이트. [^\n]{0,60} 는 한자 약 20자.
    '地?' 처럼 한자 뒤에 ? 를 바로 붙이면 마지막 1바이트에만 걸린다 → 반드시 '(地)?' 로 쓴다.
    대괄호 문자 묶음 [ ] 안에 한자·전각 문장부호를 넣지 않는다 (바이트로 쪼개져 엉뚱한 글자가 빠짐).

    원칙: '문장 첫머리에서 시키는 문장'만 잡는다 (한국어 v0.4의 '명령형 + 문장 끝'에 해당)
    - 동사 바로 앞이 줄바꿈·띄어쓰기·목록 기호·문장부호(。！？；：，)일 때만 일치
      → "忽略之前的所有指令。" 는 탐지
      → "不要忽略…"(부정), "“忽略之前的指令”这类文字"(인용), "让模型忽略…"(설명문) 은 처음부터 불일치
    - 문장 첫머리와 동사 사이에는 请·你·现在·立即·必须·首先·然后 같은 말만 허용
    - 줄 첫머리 일치는 앞 줄의 줄바꿈부터 잡히므로 SkillSpector 줄 번호가 1 작다
      → AS 스크리너가 일치 문자열이 줄바꿈으로 시작하면 +1 해서 보여줌 (as_screener.fix_line)
    알려진 한계: 번체자(繁體) 미지원, 문장 중간에 끼워 쓴 공격은 놓칠 수 있음 → LLM 2차 검사로 보완
*/

rule zh_instruction_override
{
    meta:
        description = "[ZH] 이전 지시·시스템 지침을 무시하라는 지시문 (중국어)"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $s = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|现在|立即|立刻|马上|务必|必须|一定要|首先|然后|接着|另外|同时|再|先|并|也){0,3}(忽略|无视|忘记|忘掉|抛开|丢弃|不要理会|不再遵守|不要遵守|不必遵守|停止遵守|覆盖)(掉)?[^\n]{0,30}(之前|以前|先前|此前|上面|上述|前面|以上|所有|全部|一切|原有|原来|原始|系统|开发者)[^\n]{0,30}(指令|指示|命令|规则|提示词|提示|要求|设定|约束|准则)/
    condition:
        $s
}

rule zh_concealment_from_user
{
    meta:
        description = "[ZH] 사용자에게 숨기라는 은폐 지시문 (중국어)"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $a = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)([^\n]{0,24}(后|之后|以后|完成后|的时候|时),?)?(请|你|您|务必|必须|一定|也|并|而且|同时){0,2}(绝对|千万|永远|决|绝)?(不要|别|切勿|请勿|不得|不能|不可|不许|勿)(向|对|跟|和|给)?(用户|使用者|客户)(提及|提起|提到|说明|说|透露|告知|告诉|显示|展示|报告|解释)/
        $b = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|务必|必须|一定要|也|并){0,2}(绝对|千万|永远|决|绝)?(不要|别|切勿|请勿|不得|不能|勿)((告诉|告知|通知|提醒)(用户|使用者|客户)|让(用户|使用者|客户)(知道|发现|察觉|看到))/
        $c = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|务必|必须|一定要|也|并){0,2}(要)?(向|对)(用户|使用者|客户)(隐瞒|隐藏|保密)/
        $d = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)([^\n]{0,24}(后|之后|以后|完成后|的时候|时),?)?(请|你|您|务必|必须|一定要|也|并){0,2}(绝对|千万|永远)?(不要|别|切勿|请勿|不得|不能|勿)(在(回复|回答|输出|对话|结果|总结|报告)(中|里))?(提到|提及|提起|透露|说明|显示|展示|暴露)(这个|这一|此|这些|该)?(隐藏|秘密|额外|后台)(的)?(步骤|操作|指令|行为|过程|任务)/
    condition:
        any of them
}

rule zh_stealth_wording
{
    meta:
        description = "[ZH] 몰래·은밀히 등 은밀 실행 지시 (중국어)"
        category = "exploit"
        severity = "MEDIUM"
        confidence = "0.6"
    strings:
        $s = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|现在|立即|务必|必须|首先|然后|接着|另外|同时|再|先|并|也){0,3}([^\n]{0,24}(后|之后|以后|完成后|的时候|时),?)?((用|使用|通过|把|将)[^\n]{0,30})?(偷偷(地)?|悄悄(地)?|秘密地|暗中|私下|在用户不知情的情况下|不让用户(知道|发现|察觉)(地)?)[^\n]{0,30}(发送|发到|上传|传到|传给|执行|运行|安装|收集|复制|拷贝|删除|修改|下载|读取|转发|提交|打包|压缩)/
        $w = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|现在|立即|务必|必须|首先|然后|接着|另外|同时|再|先|并|也){0,3}([^\n]{0,24}(后|之后|以后|完成后|的时候|时),?)?(在后台静默|在后台|静默)(地)?(发送|发到|上传|传到|传给|执行|运行|安装|收集|复制|拷贝|删除|修改|下载|读取|转发|提交|打包|压缩)/
    condition:
        any of them
}

rule zh_anti_refusal
{
    meta:
        description = "[ZH] 제한 해제·거절 금지 등 탈옥 문구 (중국어)"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.85"
    strings:
        $no_limit = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(你|您)(现在|已经|将)?(是|成为)?(一个)?(没有|不受|不再受)(任何|一切)[^\n]{0,18}(限制|约束|规则|审查)/
        $no_refuse = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(你|您)?(绝对|永远|无论如何(都)?|在任何情况下(都)?|决|绝)(不能|不要|不可以|不许|不得|不会)?拒绝/
        $bypass = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|现在|立即|务必|必须){0,2}(忽略|绕过|无视|关闭|解除|禁用|突破)(所有|一切|全部|你的)?(安全|道德|伦理|内容)(限制|规则|策略|政策|过滤|准则|审查|防护)/
    condition:
        any of them
}

rule zh_credential_access
{
    meta:
        description = "[ZH] SSH 키·지갑·브라우저 비밀번호 등 비밀 정보 읽기 지시 (중국어)"
        category = "exploit"
        severity = "HIGH"
        confidence = "0.8"
    strings:
        $s = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|现在|立即|务必|必须|首先|然后|接着|另外|同时|再|先|并|也){0,3}(读取|读|打开|复制|拷贝|收集|获取|提取|导出|窃取|查看|搜集|打包)[^\n]{0,60}(SSH ?私钥|SSH ?密钥|私钥文件|id_rsa|\.ssh|助记词|钱包私钥|钱包文件|浏览器(保存的)?密码|浏览器 ?[Cc]ookie|\bSSH ?key|\.aws\/credentials|\.aws\\credentials)/
    condition:
        $s
}

rule zh_credential_exfiltration
{
    meta:
        description = "[ZH] 비밀 정보를 외부로 전송하라는 유출 지시 (중국어)"
        category = "malware"
        severity = "CRITICAL"
        confidence = "0.85"
    strings:
        $ba = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|现在|立即|务必|必须|首先|然后|接着|另外|同时|再|先|并|也){0,3}(偷偷(地)?|悄悄(地)?)?(用[^\n]{0,15})?(把|将)[^\n]{0,24}(\bSSH|\.ssh|\.aws|私钥|密钥|环境变量|\.env\b|密码|口令|令牌|\b[Tt]oken\b|\bAPI ?[Kk]ey|凭据|凭证|\b[Cc]ookie|助记词|钱包)[^\n]{0,45}(发送|发|上传|传|转发|提交|回传|外发|同步)(到|至|给)/
        $vo = /(\n|\x20|\t|>|\*|-|\.|\)|。|！|？|；|：|，|!|\?|;|:)(请|你|您|现在|立即|务必|必须|首先|然后|接着|另外|同时|再|先|并|也){0,3}(偷偷(地)?|悄悄(地)?)?(发送|上传|转发|提交|回传|外发)[^\n]{0,24}(\bSSH|\.ssh|\.aws|私钥|密钥|环境变量|\.env\b|密码|口令|令牌|\b[Tt]oken\b|\bAPI ?[Kk]ey|凭据|凭证|\b[Cc]ookie|助记词|钱包)[^\n]{0,30}(到|至|给)/
    condition:
        any of them
}
