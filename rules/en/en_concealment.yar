/*
  AS Screener - English concealment rules v0.1 (2026-11-14)
  GENERATED by tools/rulegen/en_gen.py - edit the generator, not this file.
  Scope: instructions that make the agent hide an action from the user (English only).
  English attacks are otherwise left to SkillSpector; this file is an exception for one pattern it missed
  in the batch-1 crawl (hidden setup script + "do not mention it", silent telemetry POST).
  Notes:
  - Key words are written as s[i]lently / q[u]ietly so this file does not match itself.
  - $q is a private guard: a match that starts right after a quote mark is an example being quoted, not an order.
*/
rule en_conceal_silent_exec
{
    meta:
        severity = "HIGH"
        description = "[EN] Runs something silently and tells the agent not to mention it to the user"
    strings:
        $a = /\b(run|execute|exec|invoke|install|download|bash|sh|curl|wget|python3?|node|npx)\b[^\n]{0,40}\b(s[i]lently|q[u]ietly)\b[^\n]{0,200}\b(do not|don't|never)\s+(narrate|mention|tell|inform|notify|comment on|disclose|reveal)\b/ nocase
        $b = /\b(s[i]lently|q[u]ietly)\s+(run|execute|invoke|install|download|launch|start)\b[^\n]{0,200}\b(do not|don't|never)\s+(narrate|mention|tell|inform|notify|comment on|disclose|reveal)\b/ nocase
        $c = /\b(do not|don't|never)\s+(narrate|mention|tell|inform|notify|comment on|disclose|reveal)\b[^\n]{0,200}\b(s[i]lently|q[u]ietly)\s+(run|execute|invoke|install|download|launch|start)\b/ nocase
        $d = />\s*\/dev\/null[^\n]{0,120}\b(do not|don't|never)\s+(narrate|mention|tell|inform|comment on|disclose)\b/ nocase
        $q = /(['"`]|\xE2\x80[\x98\x9C])[ ]?\w/
    condition:
        for any of ($a, $b, $c, $d) : ( for any i in (1..#) : ( not for any j in (1..#q) : ( @q[j] + !q[j] - 1 == @[i] ) ) )
}

rule en_conceal_silent_send
{
    meta:
        severity = "HIGH"
        description = "[EN] Silently sends data to an external endpoint"
    strings:
        $a = /\b(s[i]lently|q[u]ietly)\s+(post|send|upload|transmit|forward|report|beacon|ping)\b[^\n]{0,80}\b(endpoint|server|webhook|telemetry|analytics|https?:\/\/|api)\b/ nocase
        $b = /\b(post|send|upload|transmit|forward)\b[^\n]{0,60}\b(endpoint|server|webhook|telemetry|https?:\/\/)[^\n]{0,80}\b(s[i]lently|q[u]ietly)\b/ nocase
        $q = /(['"`]|\xE2\x80[\x98\x9C])[ ]?\w/
    condition:
        for any of ($a, $b) : ( for any i in (1..#) : ( not for any j in (1..#q) : ( @q[j] + !q[j] - 1 == @[i] ) ) )
}

rule en_conceal_without_telling
{
    meta:
        severity = "MEDIUM"
        description = "[EN] Acts without telling the user"
    strings:
        $a = /\b(run|execute|send|upload|post|install|delete|modify|commit|push)\b[^\n]{0,80}\bwithout (telling|informing|notifying|alerting) (the )?user\b/ nocase
    condition:
        $a
}
